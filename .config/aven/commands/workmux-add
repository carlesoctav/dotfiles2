#!/usr/bin/env bash
# aven command (z a): dispatch the focused task to a workmux agent worktree.
#
# Flow: pick agent (muse/agy via binary availability, fzf) -> type worktree
# name (default: lowercase task ref) -> edit prefilled prompt in $EDITOR ->
# run `workmux add <name> -p <prompt> -a <agent> --open-if-exists` targeting
# the current tmux session (or ctrl+f project session) from the task's
# project directory -> leave an aven note as handoff context.
set -euo pipefail

context=${AVEN_COMMAND_CONTEXT:?AVEN_COMMAND_CONTEXT is required}
if [[ ! -f $context || ! -r $context ]]; then
  printf 'workmux-add: AVEN_COMMAND_CONTEXT is not a readable file.\n' >&2
  exit 2
fi

for dep in jq aven fzf workmux; do
  if ! command -v "$dep" >/dev/null 2>&1; then
    printf 'workmux-add: required command not found: %s\n' "$dep" >&2
    exit 2
  fi
done

if ! jq -e '.version == 1 and (.targeting.targets | type == "array" and length == 1)' "$context" >/dev/null; then
  printf 'workmux-add: select exactly one Aven task.\n' >&2
  exit 2
fi

task_id=$(jq -er '.targeting.targets[0].id | select(type == "string" and test("^[A-Za-z0-9]+$"))' "$context") || {
  printf 'workmux-add: selected task has no valid durable ID.\n' >&2
  exit 2
}
task_ref=$(jq -er '.targeting.targets[0].ref | select(type == "string" and test("^[A-Za-z0-9-]+$"))' "$context") || {
  printf 'workmux-add: selected task has no valid display reference.\n' >&2
  exit 2
}
project_key=$(jq -r '.selection.primary.project.key // empty' "$context")
db_path=$(jq -er '.invocation.db_path | select(type == "string" and length > 0)' "$context") || {
  printf 'workmux-add: Aven did not provide its active database path.\n' >&2
  exit 2
}
aven_exe=$(jq -r '.invocation.aven_exe // empty' "$context")
if [[ -z $aven_exe ]]; then
  aven_exe=$(command -v aven)
fi

# Resolve the task's project directory: project path mapping first, then the
# linked document's directory (nvim_file), then aven's working directory.
project_dir=''
if [[ -n $project_key ]]; then
  project_dir=$("$aven_exe" --db "$db_path" project path list "$project_key" 2>/dev/null \
    | sed -n 's/^[^ ]*[ ]*path="\(.*\)"$/\1/p' | head -n 1 || true)
fi
if [[ -z $project_dir ]]; then
  task_json=$("$aven_exe" --db "$db_path" show "$task_id" --full --json 2>/dev/null || true)
  if [[ -n ${task_json:-} ]]; then
    linked_file=$(jq -r '.metadata.nvim_file // empty' <<<"$task_json")
    if [[ -n $linked_file && $linked_file == /* ]]; then
      project_dir=$(dirname "$linked_file")
    fi
  fi
fi
if [[ -z $project_dir ]]; then
  project_dir=$(jq -r '.invocation.cwd // empty' "$context")
fi
if [[ ! -d $project_dir ]]; then
  printf 'workmux-add: could not resolve a project directory for %s.\n' "$task_ref" >&2
  exit 1
fi

# Prompt 1: agent selection over available binaries (muse, agy for now).
candidates=()
for agent in muse agy; do
  if command -v "$agent" >/dev/null 2>&1; then
    candidates+=("$agent")
  fi
done
if ((${#candidates[@]} == 0)); then
  printf 'workmux-add: no supported agent binary found (looked for: muse, agy).\n' >&2
  exit 1
fi
agent=${candidates[0]}
if ((${#candidates[@]} > 1)); then
  agent=$(printf '%s\n' "${candidates[@]}" | fzf --prompt="agent> " --height=5) || {
    printf 'workmux-add: no agent selected.\n' >&2
    exit 1
  }
fi

# Prompt 2: worktree/branch name, defaulting to the lowercase task ref.
default_name=$(tr '[:upper:]' '[:lower:]' <<<"$task_ref")
printf 'worktree name [%s]: ' "$default_name" >&2
worktree=
IFS= read -r worktree || true
worktree=${worktree:-$default_name}
if [[ -z $worktree ]]; then
  printf 'workmux-add: worktree name cannot be empty.\n' >&2
  exit 1
fi

# Prompt 3: prompt text, prefilled and editable in $EDITOR.
prompt_file=$(mktemp)
trap 'rm -f -- "$prompt_file"' EXIT
cat >"$prompt_file" <<EOF
please work on this task $task_ref, document your progress on ./logs/project/$task_ref/timeline.md, and later put notes so another agent aware of ur try
EOF
"${EDITOR:-vi}" "$prompt_file"
prompt=$(cat -- "$prompt_file")
if [[ -z ${prompt//[[:space:]]/} ]]; then
  printf 'workmux-add: prompt is empty, aborting.\n' >&2
  exit 1
fi

# Resolve target tmux session: current session if inside tmux,
# or project session via tmux-sessionizer if outside tmux.
target_session=''
if [[ -n ${TMUX:-} ]]; then
  target_session=$(tmux display-message -p '#S' 2>/dev/null || true)
else
  sessionizer=''
  self_dir=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
  for candidate in "$self_dir/../../scripts/tmux-sessionizer" "$HOME/.config/scripts/tmux-sessionizer"; do
    if [[ -f $candidate ]]; then sessionizer=$candidate; break; fi
  done
  if [[ -n $sessionizer ]]; then
    # shellcheck disable=SC1090
    . "$sessionizer"
    if command -v session_name_for >/dev/null 2>&1; then
      target_session=$(session_name_for "$project_dir")
    fi
  fi
  if [[ -z $target_session ]]; then
    target_session=$(basename "$project_dir" | tr '/.:' '_')
  fi
fi

parent_session_args=()
if [[ -n $target_session ]]; then
  parent_session_args=(--parent-session "$target_session")
fi

cd "$project_dir"
if ! workmux add "$worktree" -p "$prompt" -a "$agent" --open-if-exists "${parent_session_args[@]}"; then
  workmux open "$worktree" -p "$prompt" "${parent_session_args[@]}"
fi

"$aven_exe" --db "$db_path" note "$task_id" --stdin <<EOF
Dispatched via workmux-add: agent=$agent worktree=$worktree prompt logged in worktree.
EOF

printf 'workmux-add: dispatched %s to agent=%s worktree=%s\n' "$task_ref" "$agent" "$worktree" >&2

if [[ -z ${TMUX:-} && -n $target_session ]] && tmux has-session -t "$target_session" 2>/dev/null; then
  exec tmux attach -t "$target_session"
fi
