#!/usr/bin/env bash
# aven command (z Enter): open-or-create the focused task's workmux worktree,
# then copy the dispatch prompt to the clipboard.
#
# Minimal flow: type worktree name (default: branch stored on the task, else
# lowercase task ref) -> store it on the task -> run plain
# `workmux add <name> --open-if-exists` (no -p/-a), falling back to
# `workmux open` -> copy the prompt for pasting into your agent.
#
# Requires a running tmux server (start it before running aven).
set -euo pipefail

context=${AVEN_COMMAND_CONTEXT:?AVEN_COMMAND_CONTEXT is required}
if [[ ! -f $context || ! -r $context ]]; then
  printf 'workmux-open: AVEN_COMMAND_CONTEXT is not a readable file.\n' >&2
  exit 2
fi

for dep in jq aven workmux; do
  if ! command -v "$dep" >/dev/null 2>&1; then
    printf 'workmux-open: required command not found: %s\n' "$dep" >&2
    exit 2
  fi
done

if ! jq -e '.version == 1 and (.targeting.targets | type == "array" and length == 1)' "$context" >/dev/null; then
  printf 'workmux-open: select exactly one Aven task.\n' >&2
  exit 2
fi

task_id=$(jq -er '.targeting.targets[0].id | select(type == "string" and test("^[A-Za-z0-9]+$"))' "$context") || {
  printf 'workmux-open: selected task has no valid durable ID.\n' >&2
  exit 2
}
task_ref=$(jq -er '.targeting.targets[0].ref | select(type == "string" and test("^[A-Za-z0-9-]+$"))' "$context") || {
  printf 'workmux-open: selected task has no valid display reference.\n' >&2
  exit 2
}
project_key=$(jq -r '.selection.primary.project.key // empty' "$context")
db_path=$(jq -er '.invocation.db_path | select(type == "string" and length > 0)' "$context") || {
  printf 'workmux-open: Aven did not provide its active database path.\n' >&2
  exit 2
}
aven_exe=$(jq -r '.invocation.aven_exe // empty' "$context")
if [[ -z $aven_exe ]]; then
  aven_exe=$(command -v aven)
fi

# Resolve the task's project directory: project path mapping first, then the
# linked document's directory (nvim_file), then aven's working directory.
project_dir=''
if [[ -n $project_key ]]; then
  project_dir=$("$aven_exe" --db "$db_path" project path list "$project_key" 2>/dev/null \
    | sed -n 's/^[^ ]*[ ]*path="\(.*\)"$/\1/p' | head -n 1 || true)
fi
if [[ -z $project_dir ]]; then
  task_json=$("$aven_exe" --db "$db_path" show "$task_id" --full --json 2>/dev/null || true)
  if [[ -n ${task_json:-} ]]; then
    linked_file=$(jq -r '.metadata.nvim_file // empty' <<<"$task_json")
    if [[ -n $linked_file && $linked_file == /* ]]; then
      project_dir=$(dirname "$linked_file")
    fi
  fi
fi
if [[ -z $project_dir ]]; then
  project_dir=$(jq -r '.invocation.cwd // empty' "$context")
fi
if [[ ! -d $project_dir ]]; then
  printf 'workmux-open: could not resolve a project directory for %s.\n' "$task_ref" >&2
  exit 1
fi

# Branch prompt: default to the branch stored on the task (if any), else the
# lowercase task ref — so this always opens the correct branch.
stored_worktree=$("$aven_exe" --db "$db_path" show "$task_id" --full --json 2>/dev/null | jq -r '.metadata["workmux-worktree"] // empty' || true)
default_name=${stored_worktree:-$(tr '[:upper:]' '[:lower:]' <<<"$task_ref")}
printf 'worktree [%s]: ' "$default_name" >&2
worktree=
IFS= read -r worktree || true
worktree=${worktree:-$default_name}
if [[ -z $worktree ]]; then
  printf 'workmux-open: worktree name cannot be empty.\n' >&2
  exit 1
fi

# Remember the branch on the task for next time.
"$aven_exe" --db "$db_path" edit "$task_id" --metadata "workmux-worktree=$worktree" || {
  printf 'workmux-open: warning: could not store branch on %s.\n' "$task_ref" >&2
}

prompt="please work on this task $task_ref.

aven awareness (required): aven is this workspace's local task manager.
- Run 'aven prime' for agent guidance plus live work, and 'aven context $task_ref' for this task.
- Mark the task active: aven edit $task_ref --status active
- Leave handoff context when done or blocked with: aven note $task_ref --stdin (append-style notes), starting your note with [agent]"

# Resolve target tmux session: current session if inside tmux,
# or project session via tmux-sessionizer if outside tmux.
target_session=''
if [[ -n ${TMUX:-} ]]; then
  target_session=$(tmux display-message -p '#S' 2>/dev/null || true)
else
  sessionizer=''
  self_dir=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
  for candidate in "$self_dir/../../scripts/tmux-sessionizer" "$HOME/.config/scripts/tmux-sessionizer"; do
    if [[ -f $candidate ]]; then sessionizer=$candidate; break; fi
  done
  if [[ -n $sessionizer ]]; then
    # shellcheck disable=SC1090
    . "$sessionizer"
    if command -v session_name_for >/dev/null 2>&1; then
      target_session=$(session_name_for "$project_dir")
    fi
  fi
  if [[ -z $target_session ]]; then
    target_session=$(basename "$project_dir" | tr '/.:' '_')
  fi
fi

parent_session_args=()
if [[ -n $target_session ]]; then
  parent_session_args=(--parent-session "$target_session")
fi

cd "$project_dir"

# Plain worktree create-or-open: no -p/-a.
# --mode window is required, not just --parent-session: worktrees created
# before the window-mode migration still have mode=session stored in git
# config, and workmux rejects --parent-session for them. The override also
# self-migrates the stored mode on success.
if ! workmux add "$worktree" --open-if-exists --mode window "${parent_session_args[@]}"; then
  workmux open "$worktree" --mode window "${parent_session_args[@]}"
fi

# Copy the prompt to the clipboard for instant pasting into your agent.
# Try each clipboard tool until one succeeds; mirror into the tmux buffer
# too so prefix-] works inside tmux even without a system clipboard.
clipboard_ok=0
if command -v wl-copy >/dev/null 2>&1; then
  if printf '%s' "$prompt" | wl-copy 2>/dev/null; then clipboard_ok=1; fi
fi
if ((clipboard_ok == 0)) && command -v xclip >/dev/null 2>&1; then
  if printf '%s' "$prompt" | xclip -selection clipboard 2>/dev/null; then clipboard_ok=1; fi
fi
if ((clipboard_ok == 0)) && command -v xsel >/dev/null 2>&1; then
  if printf '%s' "$prompt" | xsel --clipboard --input 2>/dev/null; then clipboard_ok=1; fi
fi
if ((clipboard_ok == 0)) && command -v pbcopy >/dev/null 2>&1; then
  if printf '%s' "$prompt" | pbcopy 2>/dev/null; then clipboard_ok=1; fi
fi
if command -v tmux >/dev/null 2>&1; then
  tmux set-buffer -b dispatch-prompt "$prompt" 2>/dev/null || true
fi

# Keep a copy of the prompt in the worktree for the record (best effort).
wt_path=$(workmux path "$worktree" 2>/dev/null || true)
if [[ -n ${wt_path:-} && -d $wt_path ]]; then
  mkdir -p "$wt_path/.workmux"
  printf '%s\n' "$prompt" >"$wt_path/.workmux/PROMPT-$worktree.md" || true
fi

if ((clipboard_ok)); then
  printf 'workmux-open: prompt copied to clipboard — paste it into your agent in %s\n' "$worktree" >&2
else
  printf 'workmux-open: no clipboard tool worked (tried wl-copy, xclip, xsel, pbcopy); prompt printed below for manual copy\n---\n%s\n---\n' "$prompt" >&2
fi

"$aven_exe" --db "$db_path" note "$task_id" --stdin <<EOF
Opened via workmux-open: worktree=$worktree prompt copied to clipboard (branch stored on task).
EOF

printf 'workmux-open: opened %s (worktree=%s)\n' "$task_ref" "$worktree" >&2

if [[ -z ${TMUX:-} && -n $target_session ]] && tmux has-session -t "$target_session" 2>/dev/null; then
  exec tmux attach -t "$target_session"
fi
