# Ported from alacritty (see dotfiles2/.config/alacritty/).
# Effective alacritty settings: IBM Plex Mono 12, padding 14, no decorations,
# background #0e1416, foreground #dee3e5, default palette.
# NOTE: the [font] block in colors.toml is shadowed by alacritty.toml
# (the main file takes precedence over imports), so it is not ported here.

font-family = IBM Plex Mono
font-size = 12

window-padding-x = 14
window-padding-y = 14
window-decoration = none

background = #0e1416
foreground = #dee3e5

# Alacritty default palette, set explicitly so colors stay fixed
# instead of following the desktop light/dark theme.
palette = 0=#1d1f21
palette = 1=#cc6666
palette = 2=#b5bd68
palette = 3=#f0c674
palette = 4=#81a2be
palette = 5=#b294bb
palette = 6=#8abeb7
palette = 7=#c5c8c6
palette = 8=#666666
palette = 9=#d54e53
palette = 10=#b9ca4a
palette = 11=#e7c547
palette = 12=#7aa6da
palette = 13=#c397d8
palette = 14=#70c0b1
palette = 15=#eaeaea

# NOT PORTABLE to monstar v1.0.1 (no such config keys):
# - decorations = "None"  -> monstar always uses server-side decorations.
#   Workaround on KDE: System Settings > Window Management > Window Rules,
#   add rule for monstar with "No titlebar and frame" forced.
# - TERM = "xterm-256color" -> monstar always reports xterm-ghostty.
# - keyboard bindings (Shift+Insert paste, Ctrl+Insert copy, Ctrl+Enter) ->
#   v1.0.1 has no keybind support. Defaults: Ctrl+Shift+C copy,
#   Ctrl+Shift+V paste.
