#!/usr/bin/env bash
# aven command (z w): open `workmux dashboard` from the focused task's
# project directory via tmux display-popup inside tmux.
#
# workmux dashboard takes no path flag (verified in workmux source: scope is
# only all-agents vs current-session), so this resolves the directory and
# launches the dashboard there; filter by hand with `/` or `F` once open.
# Inside tmux, runs in a popup overlay; outside tmux, attaches to or creates
# the project session.
set -euo pipefail

context=${AVEN_COMMAND_CONTEXT:?AVEN_COMMAND_CONTEXT is required}
if [[ ! -f $context || ! -r $context ]]; then
  printf 'workmux-dashboard-here: AVEN_COMMAND_CONTEXT is not a readable file.\n' >&2
  exit 2
fi

for dep in jq aven workmux; do
  if ! command -v "$dep" >/dev/null 2>&1; then
    printf 'workmux-dashboard-here: required command not found: %s\n' "$dep" >&2
    exit 2
  fi
done

if ! jq -e '.version == 1 and (.targeting.targets | type == "array" and length == 1)' "$context" >/dev/null; then
  printf 'workmux-dashboard-here: select exactly one Aven task.\n' >&2
  exit 2
fi

task_id=$(jq -er '.targeting.targets[0].id | select(type == "string" and test("^[A-Za-z0-9]+$"))' "$context") || {
  printf 'workmux-dashboard-here: selected task has no valid durable ID.\n' >&2
  exit 2
}
task_ref=$(jq -er '.targeting.targets[0].ref // empty' "$context")
project_key=$(jq -r '.selection.primary.project.key // empty' "$context")
db_path=$(jq -er '.invocation.db_path | select(type == "string" and length > 0)' "$context") || {
  printf 'workmux-dashboard-here: Aven did not provide its active database path.\n' >&2
  exit 2
}
aven_exe=$(jq -r '.invocation.aven_exe // empty' "$context")
if [[ -z $aven_exe ]]; then
  aven_exe=$(command -v aven)
fi

project_dir=''
if [[ -n $project_key ]]; then
  project_dir=$("$aven_exe" --db "$db_path" project path list "$project_key" 2>/dev/null \
    | sed -n 's/^[^ ]*[ ]*path="\(.*\)"$/\1/p' | head -n 1 || true)
fi
if [[ -z $project_dir ]]; then
  task_json=$("$aven_exe" --db "$db_path" show "$task_id" --full --json 2>/dev/null || true)
  if [[ -n ${task_json:-} ]]; then
    linked_file=$(jq -r '.metadata.nvim_file // empty' <<<"$task_json")
    if [[ -n $linked_file && $linked_file == /* ]]; then
      project_dir=$(dirname "$linked_file")
    fi
  fi
fi
if [[ -z $project_dir ]]; then
  project_dir=$(jq -r '.invocation.cwd // empty' "$context")
fi
if [[ ! -d $project_dir ]]; then
  printf 'workmux-dashboard-here: could not resolve a project directory for %s, opening dashboard here.\n' "${task_ref:-task}" >&2
  project_dir=$PWD
fi

# Inside tmux: use tmux display-popup for a clean floating dashboard modal
if [[ -n ${TMUX:-} ]]; then
  exec tmux display-popup -E -w 85% -h 85% -d "$project_dir" -T " Workmux Dashboard " workmux dashboard
fi

# Outside tmux: workmux dashboard requires tmux, so attach-or-create the project's session
if ! command -v tmux >/dev/null 2>&1; then
  printf 'workmux-dashboard-here: required command not found: tmux\n' >&2
  exit 2
fi

session_for_dir() {
  local dir=$1 candidate sessionizer='' self_dir
  self_dir=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
  for candidate in "$self_dir/../../scripts/tmux-sessionizer" "$HOME/.config/scripts/tmux-sessionizer"; do
    if [[ -f $candidate ]]; then sessionizer=$candidate; break; fi
  done
  if [[ -n $sessionizer ]]; then
    # shellcheck disable=SC1090
    . "$sessionizer"
    if command -v session_name_for >/dev/null 2>&1; then
      session_name_for "$dir"
      return 0
    fi
  fi
  basename "$dir" | tr '/.:' '_'
}

session=$(session_for_dir "$project_dir")
exec tmux new-session -A -s "$session" -c "$project_dir" workmux dashboard
